{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Pi settings",
  "type": "object",
  "properties": {
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "theme": {
      "type": "string"
    },
    "defaultModel": {
      "type": "string"
    },
    "sessionDir": {
      "type": "string"
    },
    "expandTools": {
      "type": "boolean"
    },
    "hideThinkingBlock": {
      "type": "boolean"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultThinkingLevel": {
      "enum": [
        null,
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "modelThinkingLevels": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    },
    "tuiMode": {
      "enum": [
        "fullscreen",
        "regular"
      ]
    },
    "defaultProjectTrust": {
      "enum": [
        "ask",
        "always",
        "never"
      ]
    },
    "codemode": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "on",
            "only"
          ]
        },
        "inlineBudget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "autoload": {
                "type": "boolean"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "steeringMode": {
      "enum": [
        "all",
        "one-at-a-time"
      ]
    },
    "followUpMode": {
      "enum": [
        "all",
        "one-at-a-time"
      ]
    }
  }
}
