{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Pi settings",
  "type": "object",
  "properties": {
    "fullscreenExitOutput": { "enum": ["transcript", "resume-hint"] },
    "fullscreenScrollbar": { "enum": ["auto", "always", "hidden"] },
    "fullscreenCopyOnSelect": { "type": "boolean" },
    "fullscreenWheelScrollLines": { "type": ["number", "string"], "anyOf": [{"type": "number"}, {"const": "auto"}] },
    "shellPath": { "type": "string" },
    "shellCommandPrefix": { "type": "string" },
    "showHardwareCursor": { "type": "boolean" },
    "outputPad": { "enum": [0, 1] },
    "editorPaddingX": { "type": "integer", "minimum": 0, "maximum": 3 },
    "sessionShareDestination": { "enum": ["auto", "radius", "gist"] },
    "retry": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "baseDelayMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxAgentDelayMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "reserveTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "keepRecentTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "modelOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "reserveTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "keepRecentTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
            }
          }
        }
      }
    },
    "branchSummary": {
      "type": "object",
      "properties": {
        "reserveTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "skipPrompt": { "type": "boolean" }
      }
    },
    "theme": {
      "type": "string"
    },
    "defaultModel": {
      "type": "string"
    },
    "defaultProvider": {
      "type": "string"
    },
    "enabledModels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sessionDir": {
      "type": "string"
    },
    "expandTools": {
      "type": "boolean"
    },
    "hideThinkingBlock": {
      "type": "boolean"
    },
    "autocompleteMaxVisible": { "type": "integer", "minimum": 3, "maximum": 20 },
    "enableSkillCommands": { "type": "boolean" },
    "images": {
      "type": "object",
      "properties": {
        "blockImages": { "type": "boolean" },
        "autoResize": { "type": "boolean" }
      }
    },
    "mcpClientMetadataBaseUrl": { "type": "string", "minLength": 1 },
    "terminal": {
      "type": "object",
      "properties": {
        "showTerminalProgress": { "type": "boolean" },
        "showImages": { "type": "boolean" },
        "imageWidthCells": { "type": "integer", "minimum": 1 }
      }
    },
    "quietStartup": {
      "enum": [false, "header", true]
    },
    "doubleEscapeAction": {
      "enum": ["tree", "fork", "none"]
    },
    "treeFilterMode": {
      "enum": ["default", "no-tools", "user-only", "labeled-only", "all"]
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaultThinkingLevel": {
      "enum": [
        null,
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "modelThinkingLevels": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    },
    "tuiMode": {
      "enum": [
        "fullscreen",
        "regular"
      ]
    },
    "defaultProjectTrust": {
      "enum": [
        "ask",
        "always",
        "never"
      ]
    },
    "codemode": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "on",
            "only"
          ]
        },
        "inlineBudget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "autoload": {
                "type": "boolean"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "steeringMode": {
      "enum": [
        "all",
        "one-at-a-time"
      ]
    },
    "followUpMode": {
      "enum": [
        "all",
        "one-at-a-time"
      ]
    }
  }
}
